{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/pipeline/snapshot", "destination": "/api/pipeline/snapshot" },
    { "source": "/api/pipeline/changes", "destination": "/api/pipeline/changes" },
    { "source": "/api/family/snapshot", "destination": "/api/family/snapshot" },
    { "source": "/api/family/changes", "destination": "/api/family/changes" },
    { "source": "/api/business/snapshot", "destination": "/api/business/snapshot" },
    { "source": "/api/business/changes", "destination": "/api/business/changes" },
    { "source": "/api/notes/snapshot", "destination": "/api/notes/snapshot" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
