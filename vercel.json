{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/pipeline/snapshot",   "destination": "/api/pipeline/snapshot"   },
    { "source": "/api/pipeline/changes",    "destination": "/api/pipeline/changes"    },
    { "source": "/api/family/snapshot",     "destination": "/api/family/snapshot"     },
    { "source": "/api/family/changes",      "destination": "/api/family/changes"      },
    { "source": "/api/business/snapshot",   "destination": "/api/business/snapshot"   },
    { "source": "/api/business/changes",    "destination": "/api/business/changes"    },
    { "source": "/api/notes/snapshot",      "destination": "/api/notes/snapshot"      },
    { "source": "/api/agent/results",       "destination": "/api/agent/results"       },
    { "source": "/api/agent/batches",       "destination": "/api/agent/batches"       },
    { "source": "/api/cron/art-scout",      "destination": "/api/cron/art-scout"      },
    { "source": "/api/cron/job-scout",      "destination": "/api/cron/job-scout"      },
    { "source": "/api/cron/grants-scout",   "destination": "/api/cron/grants-scout"   },
    { "source": "/api/cron/batch-poller",   "destination": "/api/cron/batch-poller"   },
    { "source": "/api/test/art-scout",      "destination": "/api/test/art-scout"      },
    { "source": "/api/ping",               "destination": "/api/ping"               },
    { "source": "/(.*)",                    "destination": "/index.html"              }
  ]
}
